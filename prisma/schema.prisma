// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  PDF
  YOUTUBE
  TEXT
}

enum QuestionType {
  MCQ
  SHORT
  LONG
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())

  projects  Project[]
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  contents       Content[]
  questionBanks  QuestionBank[]
  notes          Note[]
  topicAnalysis  TopicAnalysis?
  projectContents ProjectContent[]
  embeddings Embedding[]
}

model Content {
  id        String      @id @default(uuid())
  title     String
  type      ContentType
  createdAt DateTime    @default(now())

  status    String      @default("processing")

  projectId String
  project   Project     @relation(fields: [projectId], references: [id])

  fileUrl     String?   // for PDFs
  youtubeUrl  String?   // for youtube links
  transcript  String?   // extracted transcript/text
  projects ProjectContent[]
  embeddings Embedding[]
}

model QuestionBank {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  questions Question[]
}

model Question {
  id        String       @id @default(uuid())
  type      QuestionType
  text      String
  options   Json?        // only for MCQs
  answer    String
  createdAt DateTime     @default(now())

  questionBankId String
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
}

model TopicAnalysis {
  id               String   @id @default(uuid())
  importantTopics  Json
  scoringAreas     Json
  difficultTopics  Json
  createdAt        DateTime @default(now())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id])
}

model ProjectContent {
  projectId String
  contentId String

  project Project @relation(fields: [projectId], references: [id])
  content Content @relation(fields: [contentId], references: [id])

  @@id([projectId, contentId])
}

model Embedding {
  id        String   @id @default(uuid())
  content   String   @db.Text   // chunk text
  vector    Unsupported("vector") // pgvector
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  contentId String?
  contentRef Content? @relation(fields: [contentId], references: [id])
}